# Copy to .env and fill in real values. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eve
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Shared secret used to HMAC-sign POST /payments/webhook/ requests.
WEBHOOK_SECRET=change-me-too
WEBHOOK_TOLERANCE_SECONDS=300

# JSON array; leave empty ("[]") to disable CORS entirely.
CORS_ORIGINS=[]

# Simulated payment provider.
PAYMENT_SUCCESS_RATE=0.8
ALLOW_SIMULATION_OVERRIDE=true

BOOKING_MIN_LEAD_MINUTES=30
BOOKING_MAX_ADVANCE_DAYS=180
